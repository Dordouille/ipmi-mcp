# ---- BMC connection (IPMI over LAN) ----
IPMI_HOST=192.0.2.10
IPMI_PORT=623
IPMI_USER=admin

# ---- Password (kept OUT of this file) ----
# The password lives in its OWN file, OUTSIDE this repo, that you create and
# mount into the container read-only. This variable holds only the path the
# server reads INSIDE the container — not the secret, and not a telltale name.
#
# 1) create the credential file on the host (any path/name you like), e.g.:
#      mkdir -p ~/.config/ipmi-mcp
#      printf '%s' 'your-bmc-password' > ~/.config/ipmi-mcp/credential
#      chmod 600 ~/.config/ipmi-mcp/credential
# 2) mount it when launching the container:
#      docker run ... -v ~/.config/ipmi-mcp/credential:/run/secrets/ipmi_password:ro
IPMI_PASSWORD_FILE=/run/secrets/ipmi_password
# Fallback (less safe): inline the password here instead of the file above.
#IPMI_PASSWORD=

# ---- IPMI parameters ----
# Interface driver: lanplus (IPMI 2.0 / RMCP+, recommended) or lan (1.5).
IPMI_INTERFACE=lanplus
# Privilege level: CALLBACK | USER | OPERATOR | ADMINISTRATOR.
IPMI_PRIV_LEVEL=ADMINISTRATOR
# Cipher suite, if the BMC requires a specific one (e.g. 3 or 17). Leave empty
# to let ipmitool negotiate.
IPMI_CIPHER_SUITE=

# ---- Performance on high-latency links (VPN) ----
# Local SDR cache path (inside the container). Populate it once via the
# ipmi_refresh_sdr_cache tool, then sensor reads reuse it (-S) and are fast even
# over a VPN. Mount a volume (e.g. -v .../cache:/cache) to keep it across runs.
# Leave empty to disable caching.
IPMI_SDR_CACHE=/cache/sdr.bin

# ---- Execution ----
# Per-command timeout (seconds). 120 gives ipmitool room to read the SDR
# repository the first time over a slow link (before the cache exists).
IPMI_CMD_TIMEOUT=120
# Audit log (JSONL). Mount the folder as a volume to keep it.
IPMI_AUDIT_LOG=/audit/ipmi-mcp.audit.jsonl
