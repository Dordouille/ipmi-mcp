# ---- BMC connection (IPMI over LAN) ----
IPMI_HOST=192.168.1.12
IPMI_PORT=623
IPMI_USER=admin

# Password. Passed to ipmitool via -E (IPMI_PASSWORD env var), never on the
# command line. Fill this in with your BMC credentials.
IPMI_PASSWORD=

# ---- IPMI parameters ----
# Interface driver: lanplus (IPMI 2.0 / RMCP+, recommended) or lan (1.5).
IPMI_INTERFACE=lanplus
# Privilege level: CALLBACK | USER | OPERATOR | ADMINISTRATOR.
IPMI_PRIV_LEVEL=ADMINISTRATOR
# Cipher suite, if the BMC requires a specific one (e.g. 3 or 17). Leave empty
# to let ipmitool negotiate.
IPMI_CIPHER_SUITE=

# ---- Execution ----
# Per-command timeout (seconds).
IPMI_CMD_TIMEOUT=30
# Audit log (JSONL). Mount the folder as a volume to keep it.
IPMI_AUDIT_LOG=/audit/ipmi-mcp.audit.jsonl
